# ClearLens Configuration

# App
APP_NAME=ClearLens
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# AI API Keys
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Database
DATABASE_PATH=data/clearlens.db
CACHE_TTL_SECONDS=86400
RAG_PERSIST_DIR=data/rag

# JWT (change in production!)
JWT_SECRET=clearlens-dev-secret-change-in-production
JWT_EXPIRY_SECONDS=86400

# Redis (optional, leave empty to disable)
REDIS_URL=
REDIS_ENABLED=false

# Rate Limits
RATE_LIMIT_PER_HOUR=50
MAX_ANALYSIS_PER_DAY=20
