# ClearLens Configuration

# App
APP_NAME=ClearLens
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# AI API Keys
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Groq (STT fallback — whisper-large-v3-turbo)
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_STT_MODEL=whisper-large-v3-turbo

# OpenRouter (LLM — claim extraction + reasoning)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database
DATABASE_PATH=data/clearlens.db
CACHE_TTL_SECONDS=86400
RAG_PERSIST_DIR=data/rag

# JWT (change in production!)
JWT_SECRET=clearlens-dev-secret-change-in-production
JWT_EXPIRY_SECONDS=86400

# Redis (optional, leave empty to disable)
REDIS_URL=
REDIS_ENABLED=false

# Rate Limits
RATE_LIMIT_PER_HOUR=50
MAX_ANALYSIS_PER_DAY=20

# OCR
PADDLE_OCR_ENABLED=true
EASY_OCR_ENABLED=true
OPENCV_FRAMES_ENABLED=true
OPENCV_FRAME_INTERVAL=30
